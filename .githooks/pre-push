#!/usr/bin/env sh
# The pre-push verification gate. The push is the unit of publication, so the
# gate the CI lanes run runs here first: a push that has not passed it is not
# a push, and the hook aborts it. Activate once with `make hooks` (or
# `git config core.hooksPath .githooks`). Bypassing with --no-verify is a
# deliberate act reserved for the user's hand.
set -eu

# A proof that passes with a compile warning is no proof. Every lane below
# compiles with warnings denied: rustc and rustdoc treat any warning as an
# error, so a target that emits one fails the gate here exactly as it fails
# the CI lanes, in any feature combination.
export RUSTFLAGS="-D warnings"
export RUSTDOCFLAGS="-D warnings"

echo "pre-push: the verification gate runs before anything reaches the remote"

cargo fmt --check
cargo clippy --all-targets --all-features -- -D warnings

# The fast lane: the default-feature run never boots the maelstrom harness,
# because the library, not the harness, is the deliverable.
cargo test --lib --bins --tests

# The full-feature lane: the real maelstrom binary end to end and every
# feature-gated target the matrix admits, the gate a push must
# have passed locally. The compliance corpus is feature-gated with it, so
# this lane is also the sync gate: a changed reference means regenerate
# the corpus (`make corpus-export`) and commit it, or this hook fails the
# push, and `--no-verify` remains the deliberate bypass.
cargo test --all-features --lib --bins --tests

# The doc tests under every feature, so a feature-gated module's proofs are
# run rather than skipped, and the documentation build itself: a doc link
# that no longer resolves and an unescaped type placeholder are warnings
# rustdoc denies like any other, and no other lane notices either.
cargo test --all-features --doc
cargo doc --no-deps --all-features

# The Lean formalisation: the proofs are first-class deliverables and the
# build is their gate. Warm runs are seconds on the developer's machine.
#
# Git's repository environment is cleared first. A hook runs with GIT_DIR (and
# friends) exported at this repository, and Lake drives its pinned packages
# with `git`; inheriting GIT_DIR makes those calls resolve against THIS
# repository instead of the package, so Lake decides the pinned revision is
# unreadable, discards the package and re-clones it, and then fails on the
# checkout it just made. The gate would abort every push for a defect in
# nothing. The same build passes in an ordinary shell, which is the tell.
(cd formal/uvrr-lean && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE lake build)

# The record checks, exactly as the CI lanes run them: each must find nothing.
if rg -n '#\[cfg\(test\)\]|mod tests' src; then
	echo "pre-push: inline test modules found under src" >&2
	exit 1
fi
if rg -in 'paxos' src/ tests/; then
	echo "pre-push: the banned name found in src or tests" >&2
	exit 1
fi
if git ls-files | rg -v '^maelstrom|^study/|^formal/|\.github/' | xargs rg -n 'item[0-9]'; then
	echo "pre-push: scratch-work numbering found in the product tree" >&2
	exit 1
fi < /dev/null

echo "pre-push: the gate is green, the push proceeds"
