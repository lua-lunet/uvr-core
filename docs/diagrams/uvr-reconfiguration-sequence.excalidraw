   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 15,
   "containerId": null,
   "originalText": "Five-node single-node swap \u2014 six eras (the 6-RTT schedule fuse collapses per era):",
   "lineHeight": 1.25
  },
