   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "acceptor: validate the header ONCE \u2014 view / era / membership /\nfirst-slot discipline, exactly as one Prepare.\nRefuse \u21d2 drop the WHOLE envelope, one diagnostic, no partial fold.\nPass \u21d2 explode: op at first_slot+i folds the ordinary perimeter,\nfrontier advances per op, journal = one contiguous accept.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "acceptor: validate the header ONCE \u2014 view / era / membership /\nfirst-slot discipline, exactly as one Prepare.\nRefuse \u21d2 drop the WHOLE envelope, one diagnostic, no partial fold.\nPass \u21d2 explode: op at first_slot+i folds the ordinary perimeter,\nfrontier advances per op, journal = one contiguous accept.",
   "lineHeight": 1.25
  },
