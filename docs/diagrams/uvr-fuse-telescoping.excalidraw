   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "leader: ONE FuseOk = ONE atomic vote, sender counted once\ncumulatively onto every packed slot. Majority computed on the FIRST\nmessage of the batch; the remaining slots TELESCOPE.\nQuorum on all packed slots \u21d2 commit cascade commits the batch whole,\nestablishes ONE era at the batch's first slot.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "leader: ONE FuseOk = ONE atomic vote, sender counted once\ncumulatively onto every packed slot. Majority computed on the FIRST\nmessage of the batch; the remaining slots TELESCOPE.\nQuorum on all packed slots \u21d2 commit cascade commits the batch whole,\nestablishes ONE era at the batch's first slot.",
   "lineHeight": 1.25
  },
