  },
  {
   "id": "00d474273ca3",
   "type": "text",
   "x": 930,
   "y": 176,
   "width": 520.8,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1131247331,
   "version": 1,
   "versionNonce": 767303989,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A1  'not flushed' is knowable AFTER an instant restart:\n     the unflushed sentinel must survive the crash, so it is\n     written (fsync) when the node STARTS operating.\nA2  identity = (node, incarnation); bump rule is own-id + 1.\nA3  the announce goes to ALL nodes but ONLY the leader\n     responds; every node still records (old -> new) so old\n     identity messages stay discarded forever (no redelivery\n     resurrection).\nA4  eviction is not abortable once started ('continuation\n     commitment'): the forced sequence runs to the end.\nA5  the announcer is NOT in the cluster configuration:\n     UVR messages from it are dropped by every node.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 12,
   "containerId": null,
   "originalText": "A1  'not flushed' is knowable AFTER an instant restart:\n     the unflushed sentinel must survive the crash, so it is\n     written (fsync) when the node STARTS operating.\nA2  identity = (node, incarnation); bump rule is own-id + 1.\nA3  the announce goes to ALL nodes but ONLY the leader\n     responds; every node still records (old -> new) so old\n     identity messages stay discarded forever (no redelivery\n     resurrection).\nA4  eviction is not abortable once started ('continuation\n     commitment'): the forced sequence runs to the end.\nA5  the announcer is NOT in the cluster configuration:\n     UVR messages from it are dropped by every node.",
   "lineHeight": 1.25
  }
 ],
