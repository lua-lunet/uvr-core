   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 23814792,
   "version": 1,
   "versionNonce": 457788950,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Residual shadow to close in the proofs: F5's 'dropped and logged' \u2014 which rule fires when a committed,\nera-establishing batch names an identity a LATER committed era removed? The fold is total (refusals,\nnever exceptions), so the drop is a named outcome \u2014 name it and test it, or show it unreachable.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "Residual shadow to close in the proofs: F5's 'dropped and logged' \u2014 which rule fires when a committed,\nera-establishing batch names an identity a LATER committed era removed? The fold is total (refusals,\nnever exceptions), so the drop is a named outcome \u2014 name it and test it, or show it unreachable.",
   "lineHeight": 1.25
  }
 ],
