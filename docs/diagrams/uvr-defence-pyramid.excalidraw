   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "originalText": "Narrow at the top (slow, broad, few), wide at the bottom (fast, total, many). A claim is defended by the LOWEST layer that can carry it.",
   "lineHeight": 1.25
